# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public browser client values. RLS protects admin and CMS writes.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"

# Server-only Supabase values used by the payment functions.
# Add these in Vercel Project Settings > Environment Variables, not in frontend/Vite variables.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Public Vite value used to initialize Razorpay Checkout. Never put the secret here.
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# Razorpay server credentials. Keep the secret only in server environment variables.
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_SERVER_ONLY_RAZORPAY_SECRET"

# Purchase confirmation email settings. Resend requires a verified sender domain for production delivery.
RESEND_API_KEY="YOUR_SERVER_ONLY_RESEND_API_KEY"
EMAIL_FROM="Ar. Ahmed Usmani <orders@your-domain.com>"
SUPPORT_EMAIL="ar.ahmedusmani@gmail.com"

# Used to derive and validate protected product-access tokens. Keep server-only.
ACCESS_TOKEN_SECRET="YOUR_SERVER_ONLY_ACCESS_TOKEN_SECRET"
PRODUCT_STORAGE_BUCKET="product-files"
